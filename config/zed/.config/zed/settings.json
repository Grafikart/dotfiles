{
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "git_panel": {
    "tree_view": false,
    "dock": "right",
  },
  "project_panel": {
    "dock": "left",
  },
  "session": {
    "trust_all_worktrees": false,
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-terra"
      },
      "type": "registry",
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "disable_ai": false,
  "show_edit_predictions": false,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never",
  },
  "theme": "Tokyo Night",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "code_actions_on_format": {
    "source.organizeImports": true,
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "terminal": {
    "font_fallbacks": ["Monofur Nerd Font Mono"],
  },
  "languages": {
    "Proto": {
      "format_on_save": "off",
      "code_actions_on_format": {
        "source.organizeImport": false,
      },
    },
    "PHP": {
      "language_servers": ["!intelephense", "phpactor", "..."],
    },
    "Go": {
      "formatter": "language_server",
    },
    "Make": {
      "hard_tabs": true,
      "tab_size": 4,
    },
  },
}
